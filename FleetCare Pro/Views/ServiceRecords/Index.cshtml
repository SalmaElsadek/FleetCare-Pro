@model IEnumerable<ServiceRecord>
@{
    ViewData["Title"] = "Service Records";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Service & Maintenance Records</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add New Service Record</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Vehicle (License)</th>
                        <th>Service Center</th>
                        <th>Mileage</th>
                        <th>Total Cost</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ServiceDate.ToString("yyyy-MM-dd")</td>
                                <td>@(item.Vehicle != null ? item.Vehicle.LicensePlate : "N/A")</td>
                                <td>@(item.ServiceCenter != null ? item.ServiceCenter.Name : "N/A")</td>
                                <td>@item.CurrentMileage KM</td>
                                <td class="fw-bold text-success">$@item.TotalCost.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-info text-dark">@item.Status</span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No service records found. Click the button above to add one!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>