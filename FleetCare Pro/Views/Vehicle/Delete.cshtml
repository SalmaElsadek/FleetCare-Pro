@model FleetCare_Pro.Models.Vehicle
@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Are you sure you want to delete this vehicle?</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning" role="alert">
                    This action is permanent and cannot be undone! The vehicle's image will also be removed from the server.
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Make & Model:</dt>
                    <dd class="col-sm-8">@Model.Make @Model.Model (@Model.Year)</dd>

                    <dt class="col-sm-4">License Plate:</dt>
                    <dd class="col-sm-8">@Model.LicensePlate</dd>

                    <dt class="col-sm-4">VIN:</dt>
                    <dd class="col-sm-8">@Model.VIN</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>