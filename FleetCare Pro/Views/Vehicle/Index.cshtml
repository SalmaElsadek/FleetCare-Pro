@model IEnumerable<Vehicle>
@{
    ViewData["Title"] = "Vehicles Fleet";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Vehicles Fleet</h2>
        <a asp-action="Create" class="btn btn-success">+ Add New Vehicle</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var vehicle in Model)
            {
                <div class="col-md-4 mb-4">
                    <partial name="_VehicleCard" model="vehicle" />
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">
                <div class="card shadow-sm p-4">
                    <h4>No vehicles found in the system.</h4>
                    <p class="mb-3">Start by adding your first vehicle to the fleet.</p>
                    <a asp-action="Create" class="btn btn-primary btn-sm mx-auto" style="width: fit-content;">+ Add New Vehicle</a>
                </div>
            </div>
        }
    </div>
</div>