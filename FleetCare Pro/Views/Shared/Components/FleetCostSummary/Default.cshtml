@model decimal

<div class="card shadow-sm border-0 h-100 bg-light">
    <div class="card-body d-flex flex-column justify-content-center text-center p-4">
        <div class="mb-2">
            <span class="badge bg-success bg-opacity-10 text-success p-2 rounded-circle">
                <i class="fas fa-dollar-sign fa-lg">💰</i>
            </span>
        </div>
        <h6 class="text-muted text-uppercase fw-semibold mb-2" style="font-size: 0.85rem;">Current Month Maintenance Spend</h6>
        <h2 class="text-success fw-bold display-6 mb-1">$@Model.ToString("N2")</h2>
        <p class="text-muted small mb-0">Total spend for @DateTime.Now.ToString("MMMM yyyy")</p>
    </div>
</div>